package cl.proyectosemana8;

/**
 * Representa un producto registrado en Boutique de Aromas.
 */
public class Producto {

    private String codigo;
    private String nombre;
    private int precio;
    private String origen;

    public Producto(String codigo, String nombre, int precio, String origen) {
        this.codigo = codigo;
        this.nombre = nombre;
        this.precio = precio;
        this.origen = origen;
    }

    public String getCodigo() {
        return codigo;
    }

    public String getNombre() {
        return nombre;
    }

    public int getPrecio() {
        return precio;
    }

    public String getOrigen() {
        return origen;
    }

    public void setNombre(String nombre) {
        this.nombre = nombre;
    }

    public void setPrecio(int precio) {
        this.precio = precio;
    }

    public void setOrigen(String origen) {
        this.origen = origen;
    }
}
